# Bu dosyayi .env olarak KOPYALAMA - Replit'te bunun yerine
# sol menuden "Secrets" (kilit ikonu) acip asagidaki key'i oradan ekle:
#
# Key:   APIFY_API_TOKEN
# Value: apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# NOT: Daha once bu sohbette bir Apify token paylastin. O token artik
# sohbet gecmisinde durdugu icin guvenli sayilmaz. Apify panelinden
# (Settings > Integrations) o token'i iptal edip YENI bir token olusturup
# onu Replit Secrets'a ekle.

APIFY_API_TOKEN=
